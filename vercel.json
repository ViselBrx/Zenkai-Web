{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/api/ai/proxy", "destination": "/api/ai/proxy.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)\\.html", "destination": "/pages/$1.html" },
    { "source": "/opne-anime", "destination": "/pages/open-anime.html" },
    { "source": "/opne-anime.html", "destination": "/pages/open-anime.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
